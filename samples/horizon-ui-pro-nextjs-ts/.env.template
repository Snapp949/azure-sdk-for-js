# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local or any file containing actual keys to source control.

# =============================================================================
# Zillow API Configuration
# =============================================================================
# Get your API key from one of these providers:
# - RapidAPI: https://rapidapi.com/apimaker/api/zillow-com1
# - Zillow Bridge API: https://bridgedataoutput.com/docs/explorer/zillow
#
# Leave as YOUR_KEY_HERE to use demo data instead of live Zillow data.
ZILLOW_API_KEY=YOUR_KEY_HERE

# =============================================================================
# API Configuration (Optional)
# =============================================================================
# Base URL for API calls (usually not needed for local development)
# NEXT_PUBLIC_API_BASE_URL=

# =============================================================================
# Horizon UI Pro Package (Optional)
# =============================================================================
# If using the private Horizon UI Pro package, configure your NPM_TOKEN
# in .npmrc (see .npmrc.template) and ensure the package is installed.
# NPM_TOKEN is typically set in CI/CD environment, not in .env files.

# =============================================================================
# Development Settings (Optional)
# =============================================================================
# NODE_ENV=development
# PORT=3000
